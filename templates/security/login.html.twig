{% extends 'base.html.twig' %}

{% block title %}Connexion - Blog Ostéopathie{% endblock %}

{% block body %}
    <div-class="max-w-md mx-auto">
        {# = En-tête = #}
        <header class="mb-8 texte-center">
            <h1 class="font-serif text-3xl font-bold mb-2">
                Connexion
            </h1>
            <p class="text-sepia text-sm">
                Accédez à votre compte pour commenter les articles
            </p>
        </header>    
        {# = Message d'erreur si mauvais identifiant = #}
        {% if error %}
        <div class="mb-6 p-4 bg-blue-900/30 dark:bg-red-900/30 text-red-800 dark:text-200 ronded-lg text-sm" role="alert">
            {{ error.messageKey|trans(error.messagedata, 'security') }}
        {% endif %}
        {# = Message si déjà connecté = #}
        {% if app.user %}
            <div class="mb-6 p-4 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 rounded-lg text-sm">
            Vous êtes déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
            <a href="{{ path('app_logout') }}" class="underline font-medium">Se déconnecter</a>
            </div>
        {% endif %}
        {# = formulaire = #}
        <form action="{{ path('app_login')}}" method="post" class="space-y-4 bg-white dark:bg-encre/50 p-8 rounded-lg border border-sepia/20">
            <div>
                <label for="inputEmail" class="block test-sm font-semibold mb-2">
                    Adresse email
                </label>
                <input
                    type="email"
                    value="{{last_username}}"
                    name="_username"
                    id="inputEmail"
                    required
                    autofocus
                    class="w-full px-4 py-2 bg-parchment dark:bg-encre border border-sepia/30 rounded focus:outline-none focus:border-sepia focus:ring-1 focus:ring-sepia"
                    placeholder="vous@exemple.fr">
            </div>
            <div>
                <label for="inputPassword" class="block text-sm font-semibold mb-2">
                    Mot de passe
                </label>
                <input 
                    type="password" 
                    name="_password" 
                    id="inputPassword" 
                    required
                    class="w-full px-4 py-2 bg-parchment dark:bg-encre border border-sepia/30 rounded focus:outline-none focus:border-sepia focus:ring-1 focus:ring-sepia"
                    autocomplete="current-password">
            </div>
        
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"> {# Jeton CSRF pour valider le formulaire#}
            <button type="submit" class="w-full bg-sepia hover:bg-encre text-white font-medium py-3 rounded transition-colors">
                Se connecter
            </button>
        </form>
        {# à ajouter plus tard un bouton "se souvenir de moi" #}
        {# = lien vers l'inscription = #}
        <p class="text-center mt-6 text-sm text-sepia">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="font-medium underline hover:text-encre dark:hover:text-parchment transition-colors">
                S'inscrire
            </a>
        </p>
    </div>
{% endblock %}